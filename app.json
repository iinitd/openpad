{
  "expo": {
    "name": "Clacko",
    "slug": "writer",
    "version": "1.0.2",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "puff",
    "ios": {
      "bundleIdentifier": "lol.milio.puff",
      "appleTeamId": "CH854588A4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Clacko connects to agent servers running on your computer or local network, such as Paseo, OpenClaw, and OpenCode."
      },
      "supportsTablet": true
    },
    "android": {
      "package": "lol.milio.puff",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Clacko",
      "shortName": "Clacko",
      "description": "Clacko — a writing and coding client for OpenCode, Paseo, and OpenClaw.",
      "display": "standalone",
      "startUrl": "/",
      "scope": "/",
      "themeColor": "#ffffff",
      "backgroundColor": "#ffffff",
      "barStyle": "default"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Clacko uses your photo library to attach images to a conversation."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dd2e1e62-5b9b-436d-903b-528991ecb27b"
      }
    },
    "owner": "iinitd"
  }
}
